# Google Apps Script Backend URLs
VITE_GAS_PROD_URL=https://script.google.com/macros/s/YOUR_PROD_DEPLOYMENT_ID/exec
VITE_GAS_STAGING_URL=https://script.google.com/macros/s/YOUR_STAGING_DEPLOYMENT_ID/exec

# Gemini API Key (Optional if handled by backend)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Spreadsheet IDs (Required for Script Properties)
SS_ID_CORE=
SS_ID_PEOPLE=
SS_ID_AUDIT=
SS_ID_ACCOUNT_SUBMISSIONS=
SS_ID_VOUCHING_STATS=
SS_ID_LOGGING=
SS_ID_DIRECTORY=
SS_ID_TELEGRAM_BULK_LOG=
SS_ID_MOBCON=
